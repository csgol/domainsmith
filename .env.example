# Copy this file to .env and fill in your own keys:
#   cp .env.example .env
#
# .env is git-ignored — never commit real keys.

# VirusTotal API key (v3). Free key works; free tier is ~4 req/min, 500/day.
# Get one at https://www.virustotal.com/ -> your profile -> API key.
# If left blank, burn-check.sh skips VirusTotal and runs urlscan only.
VT_API_KEY=

# urlscan.io API key (optional — the search API works unauthenticated, but a
# key raises rate limits). Get one at https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# ---- optional tuning (override script defaults) ----
# Seconds between VirusTotal calls. 16 keeps free tier under 4/min.
# VT_SLEEP=16
# Seconds between urlscan calls.
# US_SLEEP=3
# VT reputation score at/below which a domain is flagged CAUTION.
# VT_REP_FLOOR=0
